APP_ENV=local

# Port 5434, not 5432: this points at the project's own dedicated Postgres
# container (docker-compose.yml), which has the pgvector extension
# installed (Phase 6). 5432 is commonly already used by other local
# Postgres instances on this machine that we don't control.
DATABASE_URL=postgresql+asyncpg://agentops:agentops@localhost:5434/agentops_dev

DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# AI provider (Phase 2). Optional locally; app/ai/ raises a clear
# error at call time if invoked without GEMINI_API_KEY set.
# Google Gemini Developer API — Free Tier, no billing/credit card required.
# Get a free key at https://aistudio.google.com/apikey. gemini-2.5-flash-lite
# is currently Free Tier eligible; see https://ai.google.dev/gemini-api/docs/pricing
# for the current list before changing this.
GEMINI_API_KEY=replace-with-your-own-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Phase 6: separate, smaller/cheaper embeddings model — also Free Tier.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Phase 8: fallback model for every routing group (app/ai/router.py) —
# tried when GEMINI_MODEL fails. Also Free Tier, same provider/key.
GEMINI_FALLBACK_MODEL=gemini-flash-latest

# Phase 8: Redis response cache. Port 6380, not the default 6379 — this
# project's own dedicated container (docker-compose.yml), same reasoning
# as DATABASE_URL's port 5434 above.
REDIS_URL=redis://localhost:6380/0

# Frontend (Phase 0). Consumed by the browser, so it must be the
# host-published backend URL, not an in-Docker-network service name.
NEXT_PUBLIC_API_URL=http://localhost:8000